{
  "name": "@membase/openclaw-membase",
  "version": "0.4.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/aristoapp/membase.git",
    "directory": "apps/openclaw"
  },
  "main": "./index.ts",
  "devDependencies": {
    "@types/bun": "^1.2.14",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "openclaw": ">=2026.1.0"
  },
  "description": "Membase plugin for OpenClaw — persistent long-term memory for AI agents",
  "files": [
    "dist/",
    "src/",
    "skills/",
    "index.ts",
    "openclaw.plugin.json"
  ],
  "keywords": [
    "openclaw",
    "membase",
    "memory",
    "ai",
    "plugin"
  ],
  "license": "MIT",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "prepublishOnly": "bun run build",
    "lint": "biome check .",
    "check-types": "tsc --noEmit"
  },
  "type": "module"
}
